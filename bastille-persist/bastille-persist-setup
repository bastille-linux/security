#!/bin/bash
# thl-persist-setup — create a LUKS2-encrypted persistence volume on a live USB
#
# THL live USB boots without persistence by default (like Tails).
# Run this tool once to create a LUKS2 persistence partition on the same USB
# drive. On subsequent boots, live-boot will mount it automatically after
# prompting for the passphrase.
#
# What is persisted (configurable via /etc/thl/persistence.conf):
#   - GnuPG keyring (/home/user/.gnupg)
#   - WireGuard config (/etc/wireguard)
#   - SSH keys (/home/user/.ssh)
#   - THL profiles (/var/lib/thl/profiles)
#   - Browser profile (/home/user/.mozilla)
#   - i2pd router info (/var/lib/i2pd)
#   - Custom: any path listed in /etc/thl/persistence.conf
#
# Everything else is ephemeral and gone on reboot.
#
# Usage:
#   thl-persist-setup --device /dev/sdX  (create persistence partition)
#   thl-persist-setup --status           (show persistence state)
#   thl-persist-setup --nuke             (wipe persistence volume)
#
# The persistence partition is a LUKS2 container with ext4 inside,
# labelled "persistence" (required by live-boot).
# A persistence.conf inside the volume tells live-boot which directories
# to bind-mount.

set -euo pipefail

PERSIST_LABEL="persistence"
PERSIST_SIZE_MB="${THL_PERSIST_SIZE_MB:-4096}"   # 4 GB default
LUKS_CIPHER="aes-xts-plain64"
LUKS_KEYSIZE=512
LUKS_HASH="sha512"
LUKS_PBKDF="argon2id"
LUKS_PBKDF_MEM=1048576  # 1 GB RAM for Argon2id

die()  { echo "ERROR: $*" >&2; exit 1; }
info() { echo "  $*"; }

require_root() { [ "$(id -u)" -eq 0 ] || die "must run as root"; }

validate_size() {
    [[ "$PERSIST_SIZE_MB" =~ ^[0-9]+$ ]] || die "persistence size must be an integer"
    [ "$PERSIST_SIZE_MB" -ge 512 ] || die "persistence size must be at least 512 MiB"
}

validate_disk() {
    local device="$1" type
    [ -b "$device" ] || die "$device is not a block device"
    type="$(lsblk -dnro TYPE "$device" 2>/dev/null || true)"
    [ "$type" = "disk" ] || die "$device must be a whole disk, not a partition"
    findmnt -rn -S "$device" >/dev/null 2>&1 && die "$device is mounted"
    lsblk -nrpo NAME,TYPE,MOUNTPOINT "$device" | awk '$2 == "part" && $3 != "" { found=1 } END { exit found ? 0 : 1 }' \
        && die "a partition on $device is mounted"
    mountpoint -q /run/live/medium 2>/dev/null && {
        local live_medium
        live_medium="$(readlink -f /run/live/medium 2>/dev/null || true)"
        case "$live_medium" in
            "$device"|"$device"[0-9]*|"$device"p[0-9]*) die "$device contains the active live medium" ;;
        esac
    }
}

# ── Detect the USB drive we booted from ───────────────────────────────────

detect_live_device() {
    # live-boot records the boot device
    local boot_dev
    boot_dev="$(grep -o 'live-media-path=[^ ]*\|findiso=[^ ]*' /proc/cmdline 2>/dev/null || true)"

    # Try /dev/disk/by-label/THL*
    for d in /dev/disk/by-label/THL* /dev/disk/by-label/TINFOIL*; do
        [ -e "$d" ] && { readlink -f "$d"; return; }
    done

    # Fallback: ask user
    echo ""
}

# ── Create persistence partition ──────────────────────────────────────────

create_persistence() {
    local device="$1"
    require_root
    validate_size
    validate_disk "$device"

    info "Target device: $device"
    info "Persistence size: ${PERSIST_SIZE_MB} MB"
    echo
    echo "  WARNING: This will ADD a partition to $device."
    echo "  Existing partitions will NOT be modified."
    echo
    if [ "${ASSUME_YES:-0}" != 1 ]; then
        read -rp "  Type YES to continue: " ans
        [[ "$ans" == "YES" ]] || { echo "Aborted."; exit 0; }
    fi

    # Find free space at end of device
    local sectors; sectors="$(blockdev --getsz "$device")"
    local sector_size; sector_size="$(blockdev --getss "$device")"
    info "Device sectors: $sectors (sector size: $sector_size bytes)"

    # Allocate exactly the requested size from the final free region, leaving
    # 1 MiB at the end for partition-table alignment and future recovery tools.
    local free_start free_end start_mib end_mib
    free_start="$(parted -ms "$device" unit MiB print free | awk -F: '$5 == "free" { print $2; exit }')"
    free_end="$(parted -ms "$device" unit MiB print free | awk -F: '$5 == "free" { last=$3 } END { print last }')"
    [ -n "$free_start" ] && [ -n "$free_end" ] || die "could not identify free space on $device"
    start_mib="$(awk -v end="${free_end%MiB}" -v size="$PERSIST_SIZE_MB" 'BEGIN { printf "%.0f", end - 1 - size }')"
    end_mib="$(awk -v end="${free_end%MiB}" 'BEGIN { printf "%.0f", end - 1 }')"
    awk -v start="$start_mib" -v free="${free_start%MiB}" 'BEGIN { exit !(start >= free) }' \
        || die "not enough contiguous free space for ${PERSIST_SIZE_MB} MiB"
    info "Adding persistence partition from ${start_mib}MiB to ${end_mib}MiB..."
    parted -s "$device" mkpart primary "${start_mib}MiB" "${end_mib}MiB" \
        || die "parted failed — is there free space at the end of the device?"
    partprobe "$device" 2>/dev/null || true
    udevadm settle 2>/dev/null || true

    # Find new partition number
    local new_part
    new_part="$(lsblk -nrpo NAME,TYPE "$device" | awk '$2 == "part" { last=$1 } END { print last }')"
    local new_part_dev="$new_part"
    [ -b "$new_part_dev" ] || die "Could not find new partition at $new_part_dev"
    info "New partition: $new_part_dev"

    # LUKS2 format
    info "Formatting with LUKS2 (Argon2id)..."
    cryptsetup luksFormat \
        --type luks2 \
        --cipher "$LUKS_CIPHER" \
        --key-size "$LUKS_KEYSIZE" \
        --hash "$LUKS_HASH" \
        --pbkdf "$LUKS_PBKDF" \
        --pbkdf-memory "$LUKS_PBKDF_MEM" \
        --pbkdf-parallel 4 \
        --label "thl-persist" \
        "$new_part_dev"

    info "Opening LUKS container..."
    cryptsetup luksOpen "$new_part_dev" thl-persist-setup-tmp

    info "Formatting ext4..."
    mkfs.ext4 -L "$PERSIST_LABEL" /dev/mapper/thl-persist-setup-tmp

    info "Mounting..."
    local mnt; mnt="$(mktemp -d)"
    mount /dev/mapper/thl-persist-setup-tmp "$mnt"

    # Write live-boot persistence.conf
    info "Writing persistence.conf..."
    cat > "$mnt/persistence.conf" << 'EOF'
# THL live USB persistence configuration
# Syntax: <path> [options]
# live-boot bind-mounts each listed path from this volume.

/home/user/.gnupg
/home/user/.ssh
/home/user/.mozilla
/home/user/.thl
/etc/wireguard
/var/lib/thl/profiles
/var/lib/i2pd
EOF

    # Create directory structure
    for d in home/user/.gnupg home/user/.ssh home/user/.mozilla home/user/.thl \
              etc/wireguard var/lib/thl/profiles var/lib/i2pd; do
        mkdir -p "$mnt/$d"
        chmod 700 "$mnt/$d"
    done

    umount "$mnt"
    rmdir "$mnt"
    cryptsetup luksClose thl-persist-setup-tmp

    echo
    echo "  Persistence volume created on $new_part_dev"
    echo "  Label: $PERSIST_LABEL (live-boot will find it automatically)"
    echo "  Passphrase: the one you just set for LUKS"
    echo
    echo "  On next boot, live-boot will mount the persistence volume"
    echo "  and bind-mount the listed directories."
}

# ── Status ─────────────────────────────────────────────────────────────────

show_status() {
    echo "=== THL Persistence Status ==="

    # Check if running live
    if mountpoint -q /run/live/medium 2>/dev/null; then
        info "Live boot detected (medium: $(findmnt -nro SOURCE /run/live/medium 2>/dev/null || echo 'unknown'))"
    else
        info "Not running from live media"
    fi

    # Check if persistence is mounted
    if grep -q "persistence" /proc/mounts 2>/dev/null; then
        info "Persistence volume IS mounted:"
        grep "persistence" /proc/mounts | while read -r line; do
            info "  $line"
        done
    else
        info "Persistence volume NOT mounted (ephemeral boot)"
    fi

    # Check for persistence partitions
    for dev in /dev/disk/by-label/persistence*; do
        [ -e "$dev" ] && info "Found persistence partition: $(readlink -f "$dev")"
    done
}

# ── Nuke ───────────────────────────────────────────────────────────────────

nuke_persistence() {
    local device="${1:-}"
    [ -n "$device" ] || die "specify --device for nuke"
    require_root
    validate_disk "$device"

    echo "  WARNING: This will PERMANENTLY DESTROY the persistence volume on $device."
    if [ "${ASSUME_YES:-0}" != 1 ]; then
        read -rp "  Type NUKE to confirm: " ans
        [[ "$ans" == "NUKE" ]] || { echo "Aborted."; exit 0; }
    fi

    # Find the labelled LUKS partition only among children of the requested
    # disk; never let a label elsewhere in the system select the target.
    local part child label
    part=""
    while read -r child; do
        label="$(blkid -s LABEL -o value "$child" 2>/dev/null || true)"
        if [ "$label" = "thl-persist" ]; then part="$child"; break; fi
    done < <(lsblk -nrpo NAME,TYPE "$device" | awk '$2 == "part" { print $1 }')
    [ -n "$part" ] || die "No partition with label thl-persist found"
    findmnt -rn -S "$part" >/dev/null 2>&1 && die "$part is mounted"

    # Close if open
    cryptsetup luksClose thl-persist 2>/dev/null || true

    info "Shredding LUKS header..."
    cryptsetup erase "$part" 2>/dev/null || true
    shred -u -z -n 3 "$part" 2>/dev/null || dd if=/dev/urandom of="$part" bs=4M status=progress || true

    info "Removing partition..."
    local partno
    partno="$(lsblk -nrpo PARTNO "$part")"
    [[ "$partno" =~ ^[0-9]+$ ]] || die "could not determine partition number for $part"
    parted -s "$device" rm "$partno" || die "failed to remove $part"

    echo "  Persistence volume destroyed."
}

# ── Dispatch ───────────────────────────────────────────────────────────────

case "${1:---help}" in
    --device)
        [ "${2:-}" != "" ] || die "specify a whole disk with --device"
        [ "${3:-}" = "--size" ] && PERSIST_SIZE_MB="${4:-}"
        [ "${3:-}" = "--yes" ] && ASSUME_YES=1
        [ "${5:-}" = "--yes" ] && ASSUME_YES=1
        create_persistence "$2"
        ;;
    --status)
        show_status
        ;;
    --nuke)
        [ "${2:-}" != "" ] || die "specify a whole disk with --nuke"
        [ "${3:-}" = "--yes" ] && ASSUME_YES=1
        nuke_persistence "$2"
        ;;
    --help|-h|*)
        cat << 'EOF'
thl-persist-setup — LUKS2-encrypted persistence for THL live USB

Usage:
  thl-persist-setup --device /dev/sdX [--size MiB] [--yes]  create persistence partition
  thl-persist-setup --status            check persistence state
  thl-persist-setup --nuke /dev/sdX [--yes]  destroy persistence volume

The persistence partition is labelled "persistence" so live-boot
finds it automatically on next boot.
EOF
        ;;
esac
